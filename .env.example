# ---------------------------------------------------------------------------
# LeadGen Property Manager — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres connection used for ALL runtime queries.
# Supabase transaction pooler (port 6543) is preferred in production.
# The session pooler (port 5432) also works. postgres-js is always configured
# with { prepare: false, max: 1 } in lib/db/index.ts.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Optional: dedicated connection for drizzle-kit migrations only
# (Supabase session pooler, port 5432). If unset, DATABASE_URL is used.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project URL and public anon key (safe for the browser).
# RLS is enabled with no policies, so the anon key grants no data access.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Service role key. SERVER-ONLY. Never expose to the client or a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Application environment. The seed script refuses to run unless this is
# exactly "development".
APP_ENV="development"
